{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dennisadfdev"
		},
		"adls2adf_ls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'adls2adf_ls'"
		},
		"asql2adls_ls_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'asql2adls_ls'"
		},
		"blob2adf_ls_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'blob2adf_ls'"
		},
		"adls2adf_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dennisadlsdev.dfs.core.windows.net/"
		},
		"asql2adls_ls_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "dennismig.database.windows.net"
		},
		"asql2adls_ls_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dennisdb"
		},
		"asql2adls_ls_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "db_admin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "dennisadfdev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"adls2adf_ls_accountKey": {
						"value": "[parameters('adls2adf_ls_accountKey')]"
					},
					"asql2adls_ls_password": {
						"value": "[parameters('asql2adls_ls_password')]"
					},
					"blob2adf_ls_connectionString": {
						"value": "[parameters('blob2adf_ls_connectionString')]"
					},
					"adls2adf_ls_properties_typeProperties_url": {
						"value": "[parameters('adls2adf_ls_properties_typeProperties_url')]"
					},
					"asql2adls_ls_properties_typeProperties_server": {
						"value": "[parameters('asql2adls_ls_properties_typeProperties_server')]"
					},
					"asql2adls_ls_properties_typeProperties_database": {
						"value": "[parameters('asql2adls_ls_properties_typeProperties_database')]"
					},
					"asql2adls_ls_properties_typeProperties_userName": {
						"value": "[parameters('asql2adls_ls_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "dennisadfdev_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'dennisadfdev_ArmTemplate_0')]"
			]
		},
		{
			"name": "dennisadfdev_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'dennisadfdev_ArmTemplate_1')]"
			]
		}
	]
}